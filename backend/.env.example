DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory

# Which AI adapter to use: ollama | openai | anthropic
AI_PROVIDER=ollama

# ollama (local, default) - no cost, no key
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=glm-4.7-flash:latest

# openai (production)
OPENAI_API_KEY=
OPENAI_MODEL=

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Set to 1 only if the selected model can read images/PDFs.
# Defaults: off for ollama, on for openai and anthropic.
AI_VISION=0
